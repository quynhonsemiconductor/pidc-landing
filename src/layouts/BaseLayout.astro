---
// Base layout — html lang by locale, canonical + hreflang (en at /, vi at /vi/, x-default en),
// og basics, favicon, font preloads (above-the-fold: body Inter 400–600, display Space Grotesk
// 500–700 — variable files, so one preload per subset; VI pages also preload the vietnamese
// subsets), skip link as first focusable, print CSS in global.css.
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { localizedPath } from '../i18n';
import type { Dictionary, Locale } from '../i18n';

interface Props {
  dict: Dictionary;
  locale: Locale;
  title: string;
  description: string;
  path: string; // canonical path without locale prefix, e.g. "/" or "/company/"
  ogImage?: string;
  jsonLd?: object[]; // schema.org nodes (Organization, WebSite …) rendered as ld+json
}

const { dict, locale, title, description, path, ogImage, jsonLd } = Astro.props;

const canonicalUrl = new URL(localizedPath(locale, path), Astro.site).toString();
const enUrl = new URL(localizedPath('en', path), Astro.site).toString();
const viUrl = new URL(localizedPath('vi', path), Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;

// latin subsets are needed on every page; vietnamese subsets additionally on VI pages
const preloadFonts =
  locale === 'vi'
    ? [
        '/fonts/inter-latin.woff2',
        '/fonts/inter-vietnamese.woff2',
        '/fonts/space-grotesk-latin.woff2',
        '/fonts/space-grotesk-vietnamese.woff2',
      ]
    : ['/fonts/inter-latin.woff2', '/fonts/space-grotesk-latin.woff2'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="vi" href={viUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'vi_VN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'vi_VN' : 'en_US'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })}
        />
      )
    }
    {
      preloadFonts.map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>
  <body>
    <a class="c-skiplink" href="#main">{dict.ui.skipLink}</a>
    <SiteHeader locale={locale} path={path} dict={dict} />
    <slot />
    <SiteFooter locale={locale} path={path} dict={dict} />
  </body>
</html>
