---
// Contact body, shared by the EN ("/contact/") and VI ("/vi/contact/") routes — one markup
// source, every string resolved from the locale dictionary.
//
// The page is one calm thing: an address you can write to. There is no form — PIDC's clients
// are organisations that contact by email, and a form would need a handler, anti-spam and its
// own copy to say what an email already says. So: hero, S-01 "Contact us by email" (one large
// mailto, the NDA note), S-02 Office (address). The email is also in the footer on every page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pruneTodo } from '../../i18n/prune';
import { CONTACT_EMAIL } from '../../site';
import type { Dictionary, Locale } from '../../i18n';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const t = pruneTodo(dict.contact);
const contactEmail = CONTACT_EMAIL; // one constant (src/site.ts); also used by the footer
const { title, description } = dict.contact.pageMeta;
---

<BaseLayout
  dict={dict}
  locale={locale}
  path="/contact/"
  title={title}
  description={description}
  ogImage="/assets/og/contact.png"
>
  <main id="main" class="r-contact">
    <section class="l-pagehero l-page" aria-labelledby="page-title">
      <div class="c-hero">
        <p class="c-hero__badge">
          <span class="c-hero__dot" aria-hidden="true"></span>{t.hero.badge}
        </p>
        <h1 id="page-title" class="c-hero__title">{t.hero.title}</h1>
        <p class="c-hero__lede">{t.hero.lede}</p>
      </div>
    </section>

    <section class="l-band" id="email" aria-labelledby="email-title">
      <div class="l-page r-section-split">
        <header class="c-section">
          <p class="c-section__eyebrow">{t.email.eyebrow}</p>
          <h2 class="c-section__title" id="email-title">{t.email.title}</h2>
        </header>
        <div class="l-office">
          <a class="c-contact-mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          <p class="c-callout l-im">{t.office.nda}</p>
        </div>
      </div>
    </section>

    <section class="l-band" id="office" aria-labelledby="office-title">
      <div class="l-page r-section-split">
        <header class="c-section">
          <p class="c-section__eyebrow">{t.office.eyebrow}</p>
          <h2 class="c-section__title" id="office-title">{t.office.title}</h2>
        </header>
        <div class="l-office">
          <address class="c-office">{t.office.address}</address>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
