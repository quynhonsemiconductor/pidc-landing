---
// Site header — markup/classes ported from the locked mockup (design/screens/index.html c-sitehead).
import { localizedPath } from '../i18n';
import type { Dictionary, Locale } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  locale: Locale;
  path: string; // canonical path without locale prefix, e.g. "/" or "/company/"
  dict: Dictionary;
}

const { locale, path, dict } = Astro.props;
const navItems = [
  { href: '/', label: dict.nav.project },
  { href: '/why-vietnam/', label: dict.nav.vietnamGiaLai },
  { href: '/ai-data-center/', label: dict.nav.aiDataCenters },
  { href: '/company/', label: dict.nav.company },
  { href: '/contact/', label: dict.nav.contact },
].map((item) => ({
  ...item,
  localized: localizedPath(locale, item.href),
  current: item.href === path,
}));
---

<header class="c-sitehead" id="top">
  <div class="l-page c-sitehead__in">
    <a class="c-sitehead__brand" href={localizedPath(locale, '/')}>
      <span class="c-sitehead__name">{dict.brand.name}</span>
      <span class="c-sitehead__sub">{dict.brand.sub}</span>
    </a>
    <nav class="c-sitehead__nav" aria-label={dict.ui.siteNav}>
      {
        navItems.map((item) => (
          <a href={item.localized} aria-current={item.current ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <LangSwitch locale={locale} path={path} dict={dict} />
    <MobileMenu locale={locale} path={path} dict={dict} />
  </div>
</header>
