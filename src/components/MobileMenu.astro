---
// Mobile menu — the design-review change: a FULL-WIDTH panel under the header holding BOTH the
// nav links and the EN/VI switch. Base is a native <details> (works without JS); the small inline
// module script below is THE ONLY JS ON THE SITE (BUILD-NOTES 3). Inline module scripts are
// deferred by default and run after parse.
import { localizedPath } from '../i18n';
import type { Dictionary, Locale } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  path: string;
  dict: Dictionary;
}

const { locale, path, dict } = Astro.props;
const navItems = [
  { href: '/', label: dict.nav.project },
  { href: '/why-vietnam/', label: dict.nav.vietnamGiaLai },
  { href: '/ai-data-center/', label: dict.nav.aiDataCenters },
  { href: '/company/', label: dict.nav.company },
  { href: '/contact/', label: dict.nav.contact },
].map((item) => ({
  ...item,
  localized: localizedPath(locale, item.href),
  current: item.href === path,
}));
---

<details class="c-sitemenu" id="site-menu">
  <summary
    aria-expanded="false"
    aria-controls="site-menu-panel"
    data-open-label={dict.ui.menuOpen}
    data-close-label={dict.ui.menuClose}
  >
    <span>{dict.ui.menu}</span>
    <span class="c-sitemenu__mark" aria-hidden="true"></span>
  </summary>
  <div class="c-sitemenu__panel" id="site-menu-panel">
    <nav aria-label={dict.ui.siteNav}>
      {
        navItems.map((item) => (
          <a href={item.localized} aria-current={item.current ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <LangSwitch locale={locale} path={path} dict={dict} />
  </div>
</details>

<script is:inline type="module">
  (() => {
    const menu = document.getElementById('site-menu');
    if (!menu) return;
    const toggle = menu.querySelector('summary');
    const panel = menu.querySelector('.c-sitemenu__panel');
    if (!toggle || !panel) return;

    // native <details> emits "toggle" on every open/close, whatever triggered it
    menu.addEventListener('toggle', () => {
      toggle.setAttribute('aria-expanded', String(menu.open));
      toggle.setAttribute(
        'aria-label',
        menu.open ? toggle.dataset.closeLabel : toggle.dataset.openLabel,
      );
      document.documentElement.classList.toggle('menu-open', menu.open); // body scroll lock
      if (menu.open) {
        const first = panel.querySelector('a');
        if (first) first.focus(); // focus moves into the panel on open
      } else {
        toggle.focus(); // and returns to the toggle on close
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false; // closing fires "toggle" above, which restores focus
      }
    });
  })();
</script>
